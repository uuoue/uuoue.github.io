.posts-expand .post-block {
  background: #fff;                        // 白底
  padding: 40px 50px;                      // 内边距
  margin-bottom: 30px;                     // 卡片间距
  border-radius: 6px;                      // 圆角
  box-shadow: 0 1px 4px rgba(0,0,0,0.06); // 阴影
}

.posts-expand .post-title {
  text-align: center;                      // 标题居中
  font-size: 26px;
}

.posts-expand .post-meta {
  text-align: center;                      // 日期分类居中
  color: #999;
}

.posts-expand .post-button {
  text-align: center;                      // 按钮居中
}

.posts-expand .post-button .btn {
  background: #fff;
  border: 1px solid #222;                  // 黑色边框按钮
  border-radius: 3px;
  padding: 8px 24px;
}
.sidebar-inner {
  position: sticky;
  top: 20px;
}