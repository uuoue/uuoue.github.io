// ===== 首页文章卡片 =====
.posts-expand .post-block {
  background: #fff;
  padding: 30px 35px;
  margin-bottom: 30px;
  border-radius: 6px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

// 文章标题居中
.posts-expand .post-title {
  text-align: center;
  font-size: 24px;
  font-weight: 500;
  margin-bottom: 12px;
}

// 元数据（日期、分类）居中灰色
.posts-expand .post-meta {
  text-align: center;
  color: #999;
  font-size: 13px;
  margin-bottom: 25px;
}

// 摘要正文
.posts-expand .post-body {
  color: #444;
  line-height: 1.8;
  font-size: 15px;
}

// “阅读全文”按钮
.posts-expand .post-button {
  text-align: center;
  margin-top: 25px;
}

.posts-expand .post-button .btn {
  background: #fff;
  border: 1px solid #222;
  color: #222;
  border-radius: 3px;
  padding: 6px 20px;
  font-size: 13px;
}

.posts-expand .post-button .btn:hover {
  background: #222;
  color: #fff;
}

// 首页文章之间加大间距
.posts-expand .post-block:not(:first-child) {
  margin-top: 30px;
}